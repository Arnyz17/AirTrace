# AirTrace Backend — Environment Variables
#
# Copy this file to .env and fill in values as needed.
# The backend runs fully without any API keys in mock-data mode.

# HTTP port the server listens on
PORT=3001

# Application environment: development | production | test
NODE_ENV=development

# URL of the frontend development server (used for CORS allow-list).
# Add multiple origins separated by commas.
# Common local frontend ports: 3000 (CRA), 5173 (Vite), 5174 (Vite alt)
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Path to the SQLite database file.
# Defaults to ./data/airtrace.db relative to the backend directory.
# Use :memory: for an in-memory database (tests only).
DATABASE_PATH=./data/airtrace.db
